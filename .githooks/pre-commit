#!/bin/sh
# OffBall pre-commit hook.
#
# Blocks a commit that changes a governed file (docs, designs, contracts) without
# also staging VERSION.md. Three people work here with separate Claude Code
# sessions that cannot see each other; VERSION.md is how a session learns that a
# design or contract moved.
#
# Enable once per clone:   git config core.hooksPath .githooks
# Emergency bypass:        git commit --no-verify   (then log it in the next commit)

# CI passes a pull request's changed files in VERSION_CHECK_FILES (.github/workflows/version-log.yml)
staged=${VERSION_CHECK_FILES:-$(git diff --cached --name-only --diff-filter=ACMR)}

governed=$(printf '%s\n' "$staged" | grep -E '^([A-Za-z_]+\.md|docs/design/[^/]+\.md|contracts/.+)$' | grep -v '^VERSION\.md$')

[ -z "$governed" ] && exit 0

if printf '%s\n' "$staged" | grep -q '^VERSION\.md$'; then
    exit 0
fi

cat <<EOF

  Commit blocked: governed files changed without a VERSION.md entry.

  Changed:
$(printf '%s\n' "$governed" | sed 's/^/      /')

  Add an entry at the top of the log in VERSION.md, then stage it:

      ## vX.Y.Z · $(date +%Y-%m-%d) · <your name>
      **Files:** <governed files touched>
      **Type:** MAJOR | MINOR | PATCH
      - what changed, and why it matters to someone else
      - **Action required:** <anything a teammate must do>

      git add VERSION.md

  Contracts also need all three to agree before changing.

  Genuine emergency: git commit --no-verify

EOF
exit 1
