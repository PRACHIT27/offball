# Broadcast cue manager + producer console: stats hub in, Web PubSub out, HTTP on :8080. linux/amd64.
FROM python:3.12-slim
WORKDIR /app
COPY pyproject.toml ./
COPY broadcast broadcast
RUN pip install --no-cache-dir ".[broadcast]"
USER 1000
ENV PORT=8080
EXPOSE 8080
CMD ["python", "-m", "broadcast.service"]
